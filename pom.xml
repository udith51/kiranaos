<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.4</version>
        <relativePath/>
    </parent>

    <!-- Basic Info -->
    <groupId>com.kiranaos</groupId>
    <artifactId>kiranaos</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!-- Modules -->
    <modules>
        <module>kiranaos-discovery</module>
        <module>kiranaos-gateway</module>
    </modules>

    <!-- Properties -->
    <properties>
        <java.version>17</java.version>

        <!-- SonarCloud -->
        <sonar.projectKey>udith51_kiranaos</sonar.projectKey>
        <sonar.organization>udith51</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>

        <!-- JaCoCo (for Sonar) -->
        <sonar.coverage.jacoco.xmlReportPaths>
            kiranaos-discovery/target/site/jacoco/jacoco.xml,
            kiranaos-gateway/target/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
    </properties>

</project>